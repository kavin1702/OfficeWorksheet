{
  "buildCommand": "echo 'Static build successful'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admi", "destination": "/admin.html" },
    { "source": "/((?!admin|css|js|assets|manifest|sw|robots|sitemap|app-standalone|chat-history|.*\\..*).*)", "destination": "/index.html" }
  ]
}

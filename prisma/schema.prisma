datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEAM_MEMBER
}

enum WorkType {
  WORKED
  TESTED
}

enum TaskStatus {
  COMPLETED
  IN_PROGRESS
  PENDING
  BLOCKED
  UNDER_REVIEW
  LEAVE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  username     String      @unique
  passwordHash String
  role         Role        @default(TEAM_MEMBER)
  avatar       String?
  color        String      @default("#3b82f6")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workEntries  WorkEntry[]

  @@index([email])
}

model WorkEntry {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String
  date        String     // Format: YYYY-MM-DD
  projectName String
  workType    WorkType   @default(WORKED)
  work        String     @db.Text
  status      TaskStatus @default(IN_PROGRESS)
  hoursWorked Float      @default(0.0)
  priority    Priority   @default(MEDIUM)
  remarks     String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, date])
  @@index([date])
  @@index([projectName])
  @@index([status])
  @@index([workType])
}

model SimulationCatalog {
  id           String   @id @default(cuid())
  name         String   @unique
  category     WorkType
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model CloudSyncConfig {
  id             String    @id @default("default_config")
  googleSheetUrl String
  autoSync       Boolean   @default(true)
  lastSyncedAt   DateTime?
  updatedAt      DateTime  @updatedAt
}